{
  "name": "@astahmer/module-graph",
  "version": "0.14.1",
  "description": "Creates a module graph based on a given entrypoint.",
  "bin": "./bin/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node --watch index.js",
    "test": "node --test --experimental-test-coverage test/module-graph.test.js",
    "test:watch": "node --test --watch test/module-graph.test.js",
    "lint:types": "tsc",
    "lint:types:watch": "tsc --watch",
    "prepublishOnly": "tsc"
  },
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./index.js"
    },
    "./ModuleGraph.js": {
      "types": "./dist-types/ModuleGraph.d.ts",
      "default": "./ModuleGraph.js"
    },
    "./utils.js": {
      "types": "./dist-types/utils.d.ts",
      "default": "./utils.js"
    },
    "./plugins/*.js": {
      "types": "./dist-types/plugins/*.d.ts",
      "default": "./plugins/*.js"
    }
  },
  "files": [
    "README.md",
    "dist-types",
    "index.js",
    "ModuleGraph.js",
    "utils.js",
    "plugins/*.js"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/picomatch": "^2.3.3",
    "import-meta-resolve": "^4.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.3.0",
    "@thepassle/module-utils": "^0.4.0",
    "commander": "^12.0.0",
    "oxc-parser": "^0.123.0",
    "oxc-resolver": "^1.9.3",
    "picomatch": "^4.0.1"
  }
}
